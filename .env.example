TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Comisión mínima (%) para que una oferta de Shopee se publique sola. Por debajo de
# esto, la oferta se descarta (no se auto-publica ni se reenvía marcada). Default: 6.
SHOPEE_MIN_COMMISSION_PCT=6
TARGET_CHANNEL_ID=
# Canal para las ofertas de Shopee (a revisar). Vacío = usa el canal principal.
SHOPEE_CHANNEL_ID=
# Canal para las ofertas de Mercado Livre (a revisar). Vacío = usa el canal principal.
ML_CHANNEL_ID=
# Grupos a escuchar (coma-separados; por nombre o id; vacío = todos)
SOURCE_CHATS=Crowman,IAchados,Promocasinha
DEDUP_DB=dedup.db
# Credenciales propias de Shopee que cada usuario del bot generador registra con
# /registrar_shopee. Vacío = "user_credentials.db" en la carpeta del proyecto.
USER_CREDENTIALS_DB=user_credentials.db
HOOKS_FILE=hooks.txt
AMAZON_TAG=
# matt_word y matt_tool del afiliado de Mercado Livre (Central de Afiliados > tu perfil).
# Vacíos = el bot no arma el link propio y siempre reenvía la oferta a revisar a mano.
ML_MATT_WORD=
ML_MATT_TOOL=
# Bot generador de posts (bot_generador.py) — proceso separado del pipeline de ofertas.
TELEGRAM_BOT_TOKEN=
# user_id de Telegram con permiso de usar el bot generador, coma-separados.
# Vacío = nadie tiene acceso (el bot arranca pero rechaza todos los mensajes).
BOT_ALLOWED_USERS=
